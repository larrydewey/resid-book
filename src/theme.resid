// src/theme.resid — the stylesheet a book ships. One string, no build.

pub Str theme_css() {
    return ":root{--bg:#ffffff;--panel:#f6f6f4;--fg:#1b1b1f;--muted:#6b6b76;--line:#e6e4df;--accent:#2f6b5a;--accent-soft:#e6f0ec;--code:#f4f2ec;--kw:#9b2f8f;--ty:#2f6b9b;--st:#2f7b3a;--cm:#8a8a94;--nm:#a05a00;--warn:#8a5a00}"
        + "[data-theme=dark]{--bg:#131316;--panel:#1b1b20;--fg:#e9e9ec;--muted:#9a9aa6;--line:#2a2a31;--accent:#8cc4b2;--accent-soft:#1f2a26;--code:#1e1e24;--kw:#e3a6de;--ty:#8cc4e3;--st:#8ed89a;--cm:#7b7b88;--nm:#e2b45c;--warn:#e2b45c}"
        + "*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.65 ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,sans-serif}"
        + "a{color:var(--accent);text-decoration:none}a:hover{text-decoration:underline}"
        + ".top{position:sticky;top:0;z-index:10;display:flex;align-items:center;gap:14px;padding:10px 18px;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}"
        + ".brand{display:flex;align-items:center;gap:10px;font-weight:700;color:var(--fg)}.brand img{height:26px}"
        + ".grow{flex:1}.top a.repo{color:var(--muted);font-size:14px}"
        + "button.icon,.top button{font:inherit;background:var(--panel);color:var(--fg);border:1px solid var(--line);border-radius:8px;padding:6px 10px;cursor:pointer}"
        + ".search{position:relative;min-width:200px}.search input{width:100%;padding:7px 10px;font:inherit;border:1px solid var(--line);border-radius:8px;background:var(--panel);color:var(--fg)}"
        + ".results{position:absolute;top:110%;left:0;right:0;background:var(--bg);border:1px solid var(--line);border-radius:10px;box-shadow:0 12px 30px rgba(0,0,0,.12);max-height:60vh;overflow:auto;z-index:20}"
        + ".results a{display:block;padding:9px 12px;border-bottom:1px solid var(--line);color:var(--fg)}.results a:last-child{border-bottom:0}.results .d{color:var(--muted);font-size:13px;display:block}.results .none{color:var(--muted);padding:10px 12px;font-size:14px}"
        + ".shell{display:grid;grid-template-columns:270px minmax(0,1fr) 220px;max-width:1500px;margin:0 auto;gap:0}"
        + ".shell.no-toc{grid-template-columns:270px minmax(0,1fr)}"
        + "aside.side{border-right:1px solid var(--line);padding:22px 14px 60px;height:calc(100vh - 53px);overflow:auto;position:sticky;top:53px}"
        + "aside.toc{border-left:1px solid var(--line);padding:22px 14px 60px;height:calc(100vh - 53px);overflow:auto;position:sticky;top:53px;font-size:13.5px}"
        + "main{padding:30px 40px 90px;min-width:0}.main{max-width:760px}.main.wide{max-width:1040px}"
        + ".side .topic{font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin:0 0 8px 8px}"
        + ".side .grp{font-weight:600;font-size:13.5px;color:var(--fg);margin:16px 0 4px 8px}"
        + ".side a{display:block;padding:5px 8px;border-radius:7px;color:var(--fg);font-size:14px}.side a:hover{background:var(--panel);text-decoration:none}.side a.on{background:var(--accent-soft);color:var(--accent);font-weight:600}"
        + ".toc h2{font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin:0 0 8px}.toc a{display:block;color:var(--muted);padding:3px 0}.toc a.l3{padding-left:12px}"
        + "h1{font-size:32px;line-height:1.2;margin:0 0 6px}h2{font-size:23px;margin:32px 0 10px;padding-top:6px}h3{font-size:18px;margin:24px 0 8px}"
        + ".lead{color:var(--muted);font-size:18px;margin:0 0 20px}"
        + "pre{background:var(--code);padding:14px 16px;border-radius:10px;overflow:auto;line-height:1.5}"
        + "pre code{font:13.5px/1.5 ui-monospace,SFMono-Regular,Menlo,monospace;background:none;padding:0}"
        + "code{font:.9em ui-monospace,monospace;background:var(--code);padding:.12em .35em;border-radius:5px}"
        + "figure.code{margin:16px 0}figure.code figcaption{font:13px ui-monospace,monospace;color:var(--muted);background:var(--panel);border:1px solid var(--line);border-bottom:0;border-radius:10px 10px 0 0;padding:6px 12px}figure.code pre{margin:0;border-radius:0 0 10px 10px}"
        + ".c{color:var(--cm)}.k{color:var(--kw)}.t{color:var(--ty)}.s{color:var(--st)}.n{color:var(--nm)}"
        + "table{border-collapse:collapse;width:100%;margin:16px 0}th,td{text-align:left;padding:8px 10px;border-bottom:1px solid var(--line);vertical-align:top}th{color:var(--muted);font-size:14px}"
        + "blockquote{margin:16px 0;padding:2px 16px;border-left:3px solid var(--accent);color:var(--muted)}"
        + "img{max-width:100%}"
        + ".invert-dark{filter:none}"
        + "[data-theme=dark] .invert-dark{filter:invert(1)}"
        + "@media (prefers-color-scheme:dark){:root:not([data-theme=light]) .invert-dark{filter:invert(1)}}"
        + ".rezzi{float:right;width:120px;margin:0 0 12px 20px}.rezzi-hero{width:150px}"
        + ".cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;margin:20px 0}"
        + ".card{border:1px solid var(--line);border-radius:12px;padding:16px;background:var(--panel)}.card h3{margin:0 0 6px}"
        + "a.linkcard{display:block;color:var(--fg)}a.linkcard:hover{border-color:var(--accent);text-decoration:none}a.linkcard strong{display:block;margin-bottom:4px;color:var(--accent)}a.linkcard span{color:var(--muted);font-size:14px}"
        + ".pager{display:flex;justify-content:space-between;gap:14px;margin:44px 0 0;border-top:1px solid var(--line);padding-top:18px}.pager a{font-weight:600}.pager .r{text-align:right}"
        + ".edit{font-size:13px;color:var(--muted);margin-top:8px}"
        + ".switch{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 14px;padding-bottom:12px;border-bottom:1px solid var(--line)}"
        + ".switch a{font-size:12.5px;padding:5px 9px;border-radius:999px;color:var(--muted);border:1px solid transparent}"
        + ".switch a:hover{color:var(--fg);text-decoration:none;border-color:var(--line)}"
        + ".switch a.on{color:var(--accent);border-color:currentColor;background:var(--accent-soft);font-weight:600}"
        + ".hero{padding:36px 0 10px;display:flex;gap:26px;align-items:flex-start}"
        + ".hero img{max-width:190px}"
        + "@media (max-width:640px){.hero{flex-direction:column-reverse}.hero img{max-width:130px}}"
        + ".hero>div{flex:1}.hero .tag{color:var(--muted);font-size:20px;max-width:620px}.hero .acts{margin-top:18px;display:flex;gap:10px;flex-wrap:wrap}"
        + ".hero .acts a{padding:9px 16px;border-radius:10px;background:var(--accent);color:#fff;font-weight:600}.hero .acts a.min{background:var(--panel);color:var(--fg);border:1px solid var(--line)}"
        + ".hamburger{display:none;font:inherit;background:var(--panel);color:var(--fg);border:1px solid var(--line);border-radius:8px;padding:6px 11px;cursor:pointer}"
        + ".backdrop{display:none}"
        + "@media (max-width:1100px){.shell{grid-template-columns:270px minmax(0,1fr)}aside.toc{display:none}}"
        + "@media (max-width:760px){"
        + ".shell{grid-template-columns:1fr}.hamburger{display:inline-block}main{padding:22px 18px 70px}"
        + ".top{gap:8px;padding:9px 12px}.brand span{display:none}.search{flex:1;min-width:0}"
        + "aside.side{position:fixed;top:53px;left:0;bottom:0;width:min(82vw,300px);height:auto;padding:18px 12px 60px;background:var(--bg);border-right:1px solid var(--line);transform:translateX(-100%);transition:transform .18s ease;z-index:30}"
        + "body[data-nav=open] aside.side{transform:none}"
        + "body[data-nav=open] .backdrop{display:block;position:fixed;top:53px;left:0;right:0;bottom:0;background:rgba(0,0,0,.42);z-index:25}"
        + "h1{font-size:27px}.lead{font-size:16.5px}pre{font-size:13px}"
        + ".side a{padding:9px 8px}aside.side .grp{margin-top:18px}"
        + "}";
}
